{
  "name": "gamevault",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto de Desarrollo Web de Coderhouse con arquitectura SCSS modular.",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "sass --style=expanded --no-source-map --no-error-css scss/main.scss styles/styles.css",
    "watch:css": "sass --watch --style=expanded --no-source-map --no-error-css scss/main.scss:styles/styles.css"
  },
  "devDependencies": {
    "sass": "1.106.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
